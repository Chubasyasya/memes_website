<#macro header>
    <div class="header-logged-out stylish-header">
        <div class="logo">
            <a href="${contextPath}" class="logo-link">MYMEMES</a>
        </div>
        <div class="auth-links">
            <a href="${contextPath}/home" class="auth-button home-button">Главная</a>
            <a href="${contextPath}/feed" class="auth-button feed-button">Лента</a>
            <a href="${contextPath}/login" class="auth-button login-button">Войти</a>
            <a href="${contextPath}/registration" class="auth-button register-button">Зарегистрироваться</a>
        </div>
    </div>
</#macro>
